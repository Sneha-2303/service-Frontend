<script>
function mobile_validationss(elemt) {
    var mobile = elemt.value;
    var mobilePattern = /^[6-9]\d{9}$/; // Indian phone number pattern

    var wrapper = $(elemt).closest('.phone-validate-wrapper');
    var result = wrapper.find('.mobile_vals');
    var resultAlt = wrapper.find('.mobile_vals1');

    if (mobilePattern.test(mobile)) {
        result.text("Mobile Number is Valid").css("color", "green");
        resultAlt.hide();
        return true;
    } else {
        result.text("Enter a Valid Mobile Number").css("color", "red");
        resultAlt.hide();
        return false;
    }
}
</script>




