<script>

function mobile_validationsk(elemt) {
    var mobile = elemt.value;
    var mobilePattern = /^[6-9]\d{9}$/; // Indian phone number pattern

    var wrapper = $(elemt).closest('.phone-validate-wrapper');
    var result = wrapper.find('.mobile_vals');
    var resultAlt = wrapper.find('.mobile_vals1');

    if (mobilePattern.test(mobile)) {
        result.text("Mobile Number is Valid").css("color", "green");
        resultAlt.hide();
        return true;
    } else {
        result.text("Enter a Valid Mobile Number").css("color", "red");
        resultAlt.hide();
        return false;
    }
}
</script>

<script>
    // Set the countdown duration to 10 hours (in milliseconds)
    var countdownDuration = 10 * 60 * 60 * 1000; // 10 hours in milliseconds

    function startCountdown() {
        var startTime = new Date().getTime(); // Record the start time

        var x = setInterval(function() {
            var now = new Date().getTime();
            var elapsedTime = now - startTime; // Time elapsed since the countdown started

            // Calculate the remaining time
            var remainingTime = countdownDuration - elapsedTime;

            // Calculate days, hours, minutes, and seconds
            var hours = Math.floor((remainingTime % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            var minutes = Math.floor((remainingTime % (1000 * 60 * 60)) / (1000 * 60));
            var seconds = Math.floor((remainingTime % (1000 * 60)) / 1000);

            // Display the results
            document.getElementById("hours").innerHTML = hours < 10 ? "0" + hours : hours;
            document.getElementById("minutes").innerHTML = minutes < 10 ? "0" + minutes : minutes;
            document.getElementById("seconds").innerHTML = seconds < 10 ? "0" + seconds : seconds;

            // If the countdown reaches 0, restart it
            if (remainingTime <= 0) {
                clearInterval(x);
                startCountdown(); // Restart the countdown
            }
        }, 1000);
    }

    // Start the countdown immediately when the page loads
    startCountdown();
</script>

<script>
function mobile_validations(elemt) {
    var mobile = elemt.value;
    var mobilePattern = /^[6-9]\d{9}$/; // Indian phone number pattern

    if (mobilePattern.test(mobile)) {
        $("#mobile_vals4").html("Mobile Number is Valid");
        $("#mobile_vals4").css("color", "green");
        $("#mobile_vals14").hide();
        return true; // Phone number is valid, allow form submission
    } else {
        $("#mobile_vals4").html("Enter a Valid Mobile Number");
        $("#mobile_vals4").css("color", "red");
        $("#mobile_vals14").hide();
        return false; // Phone number is invalid, prevent form submission
    }
}
</script>

